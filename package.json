{
  "name": "uhabits-server",
  "version": "0.0.0",
  "private": true,
  "description": "Server for sharing habits with friends (Loop Habit Tracker / uhabits)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "del-cli ./dist",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check:all": "npm run git-hook:pre-push && npm run git-hook:pre-commit",
    "lint:eslint": "eslint \"src/**/*.ts\"",
    "lint:prettier": "prettier \"src/**/*.ts\" --cache --check",
    "lint:types": "tsc --noEmit --skipLibCheck -p tsconfig.test.json",
    "lint:knip": "knip",
    "lint:md": "markdownlint-cli2 \"*.md\" \"!CHANGELOG.md\"",
    "lint:links": "markdown-link-check README.md --config .markdown-link-check.json",
    "lint:audit": "audit-ci --config audit-ci.jsonc",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:types && npm run lint:knip && npm run lint:md",
    "format": "prettier \"src/**/*.ts\" --write",
    "prepare": "husky",
    "test": "npm run build && npm run test:coverage",
    "test:watch": "vitest --coverage",
    "test:coverage": "vitest run --coverage",
    "git-hook:pre-commit": "npm run lint",
    "git-hook:pre-push": "npm run lint:eslint && npm run lint:prettier && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliverlorenz/uhabits-server.git"
  },
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@seriousme/openapi-schema-validator": "^2.12.0",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitest/coverage-v8": "^5.1.1",
    "audit-ci": "^7.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "del-cli": "^8.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "^6.48.0",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli2": "^0.24.2",
    "openapi-types": "^12.1.3",
    "prettier": "^3.10.1",
    "semantic-release": "^25.0.9",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
