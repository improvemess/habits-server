# Port the HTTP server listens on
PORT=3000
# Mount the server under a sub-path, e.g. /habits (empty = root)
BASE_PATH=
# Public origin incl. BASE_PATH, used for invite links (empty = derived from the request)
PUBLIC_URL=
# Express "trust proxy" setting; set to 1 behind one reverse proxy
TRUST_PROXY=false
# SQLite database file (mount a volume for its directory)
DATABASE_PATH=./data/uhabits.db
# Link on the invite landing page where friends get the app
APP_DOWNLOAD_URL=https://github.com/oliverlorenz/uhabits/releases

# Retention (days), see README
INVITE_TTL_DAYS=7
TOMBSTONE_RETENTION_DAYS=30
SHARE_INACTIVE_AFTER_DAYS=90
SHARE_DELETE_AFTER_DAYS=365
READER_RETENTION_DAYS=180
DEVICE_RETENTION_DAYS=365
CLEANUP_INTERVAL_HOURS=24

# Rate limits (requests per 15 minutes and client IP)
RATE_LIMIT_API=600
RATE_LIMIT_SECRETS=20
